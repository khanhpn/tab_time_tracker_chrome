{
  "manifest_version": 3,
  "name": "Tab Time Tracker",
  "description": "Shows how long you have been using the current active tab.",
  "version": "0.1.0",
  "action": {
    "default_title": "Tab Time Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"]
}
